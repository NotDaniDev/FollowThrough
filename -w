        <!-- EXECUTIVE ACTION DECK: Morning Audio Standup & Set Reminder / Promise -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card 1: 🎙️ Morning Standup Audio Briefing (ElevenLabs Neural Voice) -->
          <div class="rounded-xl border border-primary/30 bg-primary/5 p-5 flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-primary/50 transition">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"></span>
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wider text-primary">Daily Audio Briefing</span>
