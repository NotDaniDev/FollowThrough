      <!-- Workspace Profile Footer (ADP Enterprise) -->
      <div class="mt-auto p-4 border-t border-border">
        <p class="px-2 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Workspace</p>
        <div class="mt-2.5 flex items-center gap-3 px-2 py-1.5 rounded-lg bg-secondary/35 border border-border/40">
          <div class="grid size-8 place-items-center rounded-full bg-primary/20 text-xs font-semibold text-primary">RB</div>
