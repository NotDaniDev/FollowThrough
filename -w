          </div>
        </div>

        <!-- Hero & Inline Phone Linking Section -->
        <section class="flex flex-col gap-5 border-b border-border pb-7 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm font-medium text-primary">Your team is moving</p>
