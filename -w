                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            </div>
          </form>
        </section>

        <!-- 4-Card KPI Metrics Grid (Lovable format) -->
        <section class="grid overflow-hidden rounded-lg border border-border bg-panel md:grid-cols-4 shadow-sm">
          <!-- Active Card -->
          <div class="p-5 md:p-6 border-b border-border md:border-b-0 md:border-r">
