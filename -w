            <div>
              <span class="text-foreground font-semibold">Photon iMessage Assigned Line:</span>
              <strong id="banner-assigned-phone" class="font-mono text-primary font-bold ml-1">+1 (415) 217-9994</strong>
              <span class="text-muted-foreground block sm:inline sm:ml-2">
                (Linked: <span id="banner-linked-phone" class="font-mono text-foreground">+18622370408</span>)
