              <div>
                <h3 class="font-display text-base font-semibold text-foreground flex items-center gap-2">
                  <span>🎙️ Morning Executive Standup</span>
                </h3>
                <p class="text-xs text-muted-foreground mt-1 leading-relaxed">
                  Listen to an AI-synthesized audio debrief of all active team promises, today's deadlines, and critical orphan risks.
                </p>
              </div>
            </div>

            <!-- Audio Player Controls -->
            <div class="mt-4 pt-3 border-t border-primary/15 flex flex-wrap items-center gap-2">
              <button id="btn-play-standup" type="button" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-xs font-semibold cursor-pointer transition-all bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2">
                <svg id="icon-play-standup" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play">
                  <polygon points="6 3 20 12 6 21 6 3"></polygon>
                </svg>
                <span id="label-play-standup">Play Morning Briefing</span>
              </button>

              <button id="btn-toggle-script" type="button" class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md text-xs font-medium cursor-pointer transition-colors border border-border/80 bg-secondary/50 hover:bg-accent h-9 px-3 text-muted-foreground hover:text-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text">
