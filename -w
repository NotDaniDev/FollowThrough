            </div>
            <audio id="audio-element" class="hidden"></audio>
          </div>

          <!-- Card 2: ⏰ Set Custom Reminder & Promise (Photon Spectrum Proactive Alerts) -->
          <div class="rounded-xl border border-border bg-panel p-5 flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-primary/40 transition">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
