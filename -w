            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[11px] text-muted-foreground">Carrier tip: Send <strong>START</strong> to unlock texts</span>
            <a id="banner-messages-link" href="sms:+14152179994&body=START" class="px-2.5 py-1 rounded bg-primary text-primary-foreground text-[11px] font-semibold hover:bg-primary/90 transition shadow-xs flex items-center gap-1">
