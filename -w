          <!-- Needs Owner Card -->
          <div class="p-5 md:p-6 border-b border-border md:border-b-0 md:border-r">
            <div class="flex items-center justify-between text-muted-foreground">
              <span class="text-xs font-medium uppercase tracking-wider">Needs owner</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-round-check text-warning">
